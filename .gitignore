# --- Результаты сборки ---------------------------------------------------
# Каталоги пресетов CMake: out/build/vs-x86, out/build/vs-vcpkg-x86-static и т.д.
out/
build/

# --- Зависимости vcpkg ---------------------------------------------------
# Ставятся по vcpkg.json при конфигурации, в репозитории не нужны.
vcpkg_installed/

# --- Служебные файлы CMake и Ninja ---------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
*.ninja
.ninja_deps
.ninja_log

# --- Двоичные результаты компиляции --------------------------------------
# ВНИМАНИЕ: win32/*.def — это ИСХОДНИК (список экспорта), он не игнорируется.
*.dll
*.exe
*.lib
*.exp
*.ilk
*.pdb
*.obj
*.o
*.a
*.so
*.dylib

# --- Visual Studio -------------------------------------------------------
.vs/
*.user
*.suo
*.sln.docstates

# --- JetBrains (CLion, Rider) --------------------------------------------
.idea/
cmake-build-*/

# --- Visual Studio Code --------------------------------------------------
.vscode/

# --- macOS ---------------------------------------------------------------
.DS_Store
._*

# --- Windows -------------------------------------------------------------
Thumbs.db
desktop.ini

